# ─────────────────────────────────────────────────────────────────────────────
# Cafe Manager — Environment Variables Configuration
# Copy this file to .env for local development.
# For Render deployment, add these exact keys to the Render Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core Settings ──────────────────────────────────────────────────────
# Production: Set to a strong 50+ character secret key
SECRET_KEY=django-insecure-cafe-manager-prod-key-xyz9876543210abc

# Production: Set to False. Local: Set to True
DEBUG=False

# Allowed hostnames (comma-separated). Render automatically handles its own hostname.
ALLOWED_HOSTS=*

# ── Database Settings (Choose ONE method) ─────────────────────────────────────
# METHOD 1 (Recommended for Production on Render/Neon): Single Database URI
# Render automatically injects DATABASE_URL when you attach a Render Postgres database.
DATABASE_URL=postgresql://username:password@ep-xyz.singapore.aws.neon.tech/cafe_manager_db?sslmode=require

# METHOD 2 (Local Development via pgAdmin / Local Postgres):
DB_NAME=cafe_manager
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432

# ── Security & CORS Settings ──────────────────────────────────────────────────
# Comma-separated allowed frontend origins (MUST include full https:// scheme in production)
CORS_ALLOWED_ORIGINS=https://cafe-managment-ruddy.vercel.app,http://localhost:5173

# Comma-separated CSRF trusted origins for cross-domain POST/PATCH requests
CSRF_TRUSTED_ORIGINS=https://cafe-managment-ruddy.vercel.app,http://localhost:5173

# ── Email Settings (Gmail SMTP for OTP & Password Reset) ──────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=cafemanagment6@gmail.com

# 16-character Google App Password (generated in Google Account -> Security -> App Passwords)
EMAIL_HOST_PASSWORD=your_16_digit_app_password

DEFAULT_FROM_EMAIL=cafemanagment6@gmail.com
EMAIL_TIMEOUT=10
